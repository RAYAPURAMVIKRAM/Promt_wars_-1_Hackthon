# ==============================================================================
# CrisisBridge Environment Variables
# Copy this file to .env or .env.local for local development.
# Also set these in Vercel / Streamlit / Cloud Run Environment Settings.
# ==============================================================================

# 1. Supabase Configuration (Master Database)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 2. Google Gemini API Key (Two-Stage Anti-Hallucination AI Pipeline)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Server Configuration
PORT=8080
HOST=0.0.0.0
